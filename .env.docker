# =====================================================
# 🐳 Docker Local Development Environment
# =====================================================
# ใช้สำหรับรัน local ผ่าน Docker (Laravel Sail)
# วิธีใช้: cp .env.docker .env  (บนเครื่อง local เท่านั้น!)
# ⚠️  อย่าใช้ไฟล์นี้บน Cloud Server!
# =====================================================

APP_NAME="CPE Repair System"
APP_ENV=local
APP_KEY=base64:1rZJ8u2nOctNLe0VfH36LnufoY8nTaIiLOJWyeL4jYg=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH
APP_TIMEZONE=Asia/Bangkok

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- 🗄️ Database (Docker MySQL) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cpe_repair
DB_USERNAME=sail
DB_PASSWORD=password

# --- ⚡ Queue / Session / Cache (Docker Redis) ---
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- 📧 Email (Mailpit - จับอีเมลดูตอน dev) ---
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@cperepair.app"
MAIL_FROM_NAME="CPE Service System"

# --- 🔑 Brevo HTTP API (เก็บไว้เผื่อต้องส่งจริง) ---
BREVO_KEY=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

# --- 🔥 Firebase ---
FIREBASE_CREDENTIALS=storage/app/firebase-credentials.json
VITE_FIREBASE_API_KEY=AIzaSyA0kRXESeGizZhIf0qhWUiw7VHdp4K1MPQ
VITE_FIREBASE_AUTH_DOMAIN=cpe-repair-system.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cpe-repair-system
VITE_FIREBASE_STORAGE_BUCKET=cpe-repair-system.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=264610360192
VITE_FIREBASE_APP_ID=1:264610360192:web:290e329c316e8376b0ef65

# --- Vite ---
VITE_APP_NAME="${APP_NAME}"
