# =====================================================
# 🔧 CPE Repair System — ไฟล์ตั้งค่าสำหรับ Production
# =====================================================
# วิธีใช้:
#   1. คัดลอกไฟล์นี้: cp .env.production.example .env
#   2. แก้ค่าที่มีเครื่องหมาย ← ต้องแก้ ตามคำอธิบาย
#   3. รัน: docker compose -f docker-compose.production.yml up -d --build
# =====================================================

# ─────────────────────────────────────────────────────
# 🏠 ตั้งค่าพื้นฐาน
# ─────────────────────────────────────────────────────
APP_NAME="CPE Repair System"
APP_ENV=production
APP_KEY=                              # ← ปล่อยว่าง! ระบบจะ generate ให้อัตโนมัติ
APP_DEBUG=false                       # ← ห้ามเปลี่ยนเป็น true บน production!
APP_URL=http://localhost              # ← ต้องแก้: ใส่ URL จริง เช่น https://repair.example.com
APP_PORT=80                           # ← Port ที่เว็บจะเปิด (ปกติ 80)

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH
APP_TIMEZONE=Asia/Bangkok

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ─────────────────────────────────────────────────────
# 📝 Log — บันทึกข้อผิดพลาด
# ─────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error                       # production ใช้ error (ไม่ต้องเห็น debug)

# ─────────────────────────────────────────────────────
# 🗄️ ฐานข้อมูล MySQL
# ─────────────────────────────────────────────────────
# ⚠️ DB_HOST ไม่ต้องแก้! Docker Compose ตั้งค่าให้อัตโนมัติ
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cpe_repair               # ← ชื่อฐานข้อมูล (ใช้ค่านี้ได้เลย)
DB_USERNAME=cpe_user                  # ← ชื่อผู้ใช้ฐานข้อมูล (ใช้ค่านี้ได้เลย)
DB_PASSWORD=SecurePassword123!        # ← ต้องแก้: ตั้งรหัสผ่านฐานข้อมูลที่ปลอดภัย

# ─────────────────────────────────────────────────────
# 🔗 ระบบ Session / Cache / Queue
# ─────────────────────────────────────────────────────
# ⚠️ ไม่ต้องแก้! Docker Compose ตั้งค่าให้อัตโนมัติ
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis

# ─────────────────────────────────────────────────────
# ⚡ Redis
# ─────────────────────────────────────────────────────
# ⚠️ REDIS_HOST ไม่ต้องแก้! Docker Compose ตั้งค่าให้อัตโนมัติ
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─────────────────────────────────────────────────────
# 📧 ระบบอีเมล (Brevo)
# ─────────────────────────────────────────────────────
# ระบบใช้ Brevo (เดิมชื่อ Sendinblue) ส่งอีเมล OTP, เชิญผู้ใช้, รีเซ็ตรหัส
# ขั้นตอน:
#   1. สมัครบัญชี Brevo ที่ https://www.brevo.com (ฟรี 300 อีเมล/วัน)
#   2. ไปที่ Settings → SMTP & API → API Keys
#   3. คัดลอก API Key มาใส่ BREVO_KEY ด้านล่าง
#
# ถ้ายังไม่ได้สมัคร — ปล่อย MAIL_MAILER=log ไว้ก่อน ระบบทำงานได้
# แต่จะส่งอีเมลจริงไม่ได้ (OTP จะอยู่ใน log แทน)

MAIL_MAILER=log                       # ← แก้เป็น "smtp" เมื่อมี Brevo Key แล้ว
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=465
MAIL_USERNAME=                        # ← ต้องแก้: ใส่ SMTP Login จาก Brevo
MAIL_PASSWORD=                        # ← ต้องแก้: ใส่ SMTP Password จาก Brevo
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="no-reply@cperepair.app"
MAIL_FROM_NAME="CPE Service System"

# Brevo HTTP API Key (ใช้สำหรับส่งอีเมลผ่าน API แทน SMTP)
BREVO_KEY=                            # ← ต้องแก้: ใส่ API Key จาก Brevo

# ─────────────────────────────────────────────────────
# 🔥 Firebase (Push Notification)
# ─────────────────────────────────────────────────────
# ระบบใช้ Firebase Cloud Messaging (FCM) ส่ง Push Notification
# ขั้นตอน:
#   1. สร้าง Firebase Project ที่ https://console.firebase.google.com
#   2. ไปที่ Project Settings → General → ดูค่า Config
#   3. คัดลอกค่ามาใส่ VITE_FIREBASE_* ด้านล่าง
#   4. ไปที่ Project Settings → Service accounts → Generate new private key
#   5. ดาวน์โหลดไฟล์ JSON → เปลี่ยนชื่อเป็น firebase-credentials.json
#   6. วางไว้ที่ root ของโปรเจค (ข้างๆ docker-compose.production.yml)
#
# ⚠️ ถ้าไม่ต้องการ Push Notification — ปล่อยว่างไว้ได้ ระบบทำงานปกติ

FIREBASE_CREDENTIALS=storage/app/firebase-credentials.json

VITE_APP_NAME="${APP_NAME}"
VITE_FIREBASE_API_KEY=                # ← ใส่ค่าจาก Firebase Console
VITE_FIREBASE_AUTH_DOMAIN=            # ← เช่น your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=             # ← เช่น your-project
VITE_FIREBASE_STORAGE_BUCKET=         # ← เช่น your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=    # ← ตัวเลข Sender ID
VITE_FIREBASE_APP_ID=                 # ← เช่น 1:123456:web:abcdef
VITE_FIREBASE_VAPID_KEY=              # ← ใช้สำหรับ Web Push (Cloud Messaging → Web configuration)
