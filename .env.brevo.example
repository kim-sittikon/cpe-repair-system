# ===========================================
# Brevo (Sendinblue) Email Configuration Template
# ===========================================
# วิธีใช้:
# 1. สมัคร Brevo ที่ brevo.com (ฟรี 300 emails/วัน)
# 2. ไปที่ Settings > SMTP & API > SMTP
# 3. Copy ค่ามาใส่ด้านล่าง
# 4. Copy ไปวางแทนที่ส่วน Email ใน .env
# ===========================================

# --- 📧 Email (Brevo SMTP - Enterprise) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=YOUR_BREVO_EMAIL_HERE
MAIL_PASSWORD=YOUR_BREVO_SMTP_KEY_HERE
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@cperepair.app"
MAIL_FROM_NAME="CPE Service System"

# --- 🔄 Queue Configuration (for email) ---
# เปลี่ยนจาก sync เป็น database เพื่อใช้ queue
QUEUE_CONNECTION=database

# ===========================================
# หลังจากแก้ไข .env แล้ว ให้รัน:
# docker compose exec laravel.test php artisan config:clear
# docker compose exec laravel.test php artisan queue:work --queue=emails
# ===========================================
